# LLM for classify + draft. Anthropic is tried first if set; Gemini is the fallback used in this build.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Provider credentials are resolved by the Swytchcode CLI itself via `swytchcode auth connect <provider>`
# (OAuth for Gmail/Notion/Jira/GitHub, API key prompt for Resend) — not read from env vars here.
# Run `swytchcode auth status` to confirm what's connected on this machine/host.

# Jira project to file tickets into (the project key, e.g. SUP) and the site's browsable domain
# (e.g. yourteam.atlassian.net) used to build a clickable ticket link.
# CRITICAL: Swytchcode ships with placeholder host your-domain.atlassian.net — replace it with:
#   ./scripts/set-jira-site.sh yourteam.atlassian.net SUP
JIRA_PROJECT_KEY=
JIRA_SITE_DOMAIN=

# Comma-separated Notion page IDs seeded as the knowledge base (extract the ID from each page's URL).
NOTION_KB_PAGE_IDS=

# From-address used when sending customer updates.
SUPPORT_FROM_EMAIL=
# Verified Resend sender; if unset, sends fall back to Gmail automatically.
RESEND_FROM_EMAIL=

# owner/repo used for GitHub duplicate-issue search, the Jira-fallback ticket creation,
# and cross-team duplicate comments.
GITHUB_REPO=

# Internal team address notified (via the real Gmail send path) when a case is escalated.
# Leave unset to skip this notification entirely.
INTERNAL_TEAM_EMAIL=

# Comma-separated origins allowed to call this API. Include the deployed frontend's URL in production.
CORS_ORIGINS=http://localhost:5173
